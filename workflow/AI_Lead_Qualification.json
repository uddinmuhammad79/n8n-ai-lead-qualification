        "jsCode": "const out = $json;\nlet text = out.content?.[0]?.text ?? out.message?.content ?? out.text ?? out.output;\n\nif (typeof text === 'string') {\n  // Strip markdown formatting if Claude wrapped the JSON in fences\n  text = text.replace(/```json/gi, '').replace(/```/g, '').trim();\n  return [{ json: JSON.parse(text) }];\n}\n\nreturn [{ json: text }];"
      },
